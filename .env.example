# Copy this file to .env and fill in your own values. .env is gitignored.

# Flask secret key for sessions and CSRF protection.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. Defaults to the bundled SQLite database in instance/.
# DATABASE_URL=sqlite:///campus_resource_hub.db

# Google Gemini API key. Only the AI chatbot needs it.
GEMINI_API_KEY=
